{
    "name": "mattsplat/fastresize-php",
    "description": "PHP FFI binding for fastresize - a fast C++ image decode/resize/composite/encode library - as an alternative to libvips-backed wrappers like jcupitt/vips.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-ffi": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Fastresize\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fastresize\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "build": "make -C native",
        "test": "phpunit"
    }
}
